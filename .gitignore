# OS specific files
**/.DS_Store
**/Thumbs.db

# Local agent pointer
CLAUDE.md

# Per-cluster account and path settings (see site/*.env.example)
site/*.env

# Basilisk installation and local mode flags
basilisk/
**/.comphy-basilisk
**/.docker_mode
**/.project_config

# qcc-generated portable C99 (regenerate with scripts/generate-sources.sh)
generated/
_*.c

# Compiled objects and binaries
*.o
*.a
*.so
*.out
mpi-circle
mpi-laplacian
marangoni-scale
marangoni-multidrop
marangoni-interact
activity-drop
get_fields_planar
get_facets_planar

# Slurm / run output
*.err
slurm-*.out
slurm-*.err
results/*/
results/latest
results/snellius/latest
!results/.gitkeep
figures/*.png
figures/*.svg
# Campaign PDFs and timing tables are tracked.
!figures/*.pdf
!figures/*.csv

# LaTeX build intermediates; compiled public reports under docs/ are tracked.
*.aux
*.fdb_latexmk
*.fls
*.log
*.synctex.gz
*.toc

# Python
**/__pycache__/
**/*.pyc
**/.venv

# Editor
.idea/
.vscode/
*.swp
*.swo
