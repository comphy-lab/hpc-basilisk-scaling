# Snellius settings. Copy to site/snellius.env and fill in your own
# allocation. Sourced by scripts/site-env.sh; never committed.

# Slurm account of the allocation.
SLURM_ACCOUNT=your_account

# Compact scripts and sources (project space).
PROJECT_DST=/projects/0/your_project/hpc-basilisk-scaling

# Generated C99, binaries and run output (shared scratch, purged).
SCRATCH_DST=/scratch-shared/your_user/hpc-basilisk-scaling

# SSH alias for the login node used by stage-snellius.sh and
# collect-snellius.sh.
HOST=snellius
