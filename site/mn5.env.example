# MareNostrum5 GPP settings. Copy to site/mn5.env and fill in your own
# allocation. Sourced by scripts/site-env.sh; never committed.

# Slurm account of the allocation.
SLURM_ACCOUNT=your_account

# Compact scripts and sources (project space, backed up, small quota).
PROJECT_DST=/gpfs/projects/your_account/hpc-basilisk-scaling

# Generated C99, binaries and run output (scratch space, large, purged).
SCRATCH_DST=/gpfs/scratch/your_account/your_user/hpc-basilisk-scaling

# SSH alias for the data-transfer node used by stage-mn5.sh and
# collect-results.sh.
TRANSFER=mn5-transfer
